<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.HwProbe.Core</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.HwProbe.Core</RootNamespace>
    <!-- The LibraryImport source generator emits unsafe marshalling stubs for the resource monitors' libc and libproc calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.HwProbe.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures/Bundled/*" LogicalName="Fixtures.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Data/catalog.yaml" LogicalName="catalog.yaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Framework.Win32.Jobs" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
