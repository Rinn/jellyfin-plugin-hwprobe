<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Listed in every shipped project so the lock files cover a publish with -r. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
