<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The platforms the CLI is published for. Every shipped project lists them so its lock file covers
         a publish with -r, which also restores the libraries the CLI references. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
