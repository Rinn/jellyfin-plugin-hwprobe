#!/bin/sh
# Pre-commit gate: build, format and tests must all pass. Install with:
#   git config core.hooksPath scripts/
#
# Checks the working tree, not just the staged snapshot — commit with a clean tree.
set -eu

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: dotnet build -warnaserror"
dotnet build -warnaserror --nologo -v quiet

echo "pre-commit: dotnet format --verify-no-changes"
dotnet format --verify-no-changes

echo "pre-commit: dotnet test"
dotnet test

echo "pre-commit: third-party notices"
python3 scripts/notices.py --check

if command -v node >/dev/null 2>&1; then
    echo "pre-commit: plugin page script"
    sh scripts/check-page.sh
else
    echo "pre-commit: node not found, plugin page script not checked"
fi

if command -v editorconfig-checker >/dev/null 2>&1; then
    echo "pre-commit: editorconfig-checker"
    editorconfig-checker
else
    echo "pre-commit: editorconfig-checker not found, .editorconfig rules not checked"
fi

echo "pre-commit: all checks passed"
